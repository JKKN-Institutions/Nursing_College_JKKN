# Next.js Environment Variables
# Copy this file to .env.local for local development

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Social Media Links (Update with your actual links)
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/your-page
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/your-profile
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/company/your-company
NEXT_PUBLIC_TWITTER_URL=https://twitter.com/your-profile
NEXT_PUBLIC_YOUTUBE_URL=https://www.youtube.com/@your-channel

# Contact Information
NEXT_PUBLIC_PHONE=+91 93458 55001
NEXT_PUBLIC_EMAIL=info@jkknnursing.ac.in

# Messenger Link (Update with your Facebook Page ID)
NEXT_PUBLIC_MESSENGER_LINK=https://m.me/your-page-id

# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-Q72FWCD9PN

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>

# College identity — UUID of the Nursing college in the `colleges` table.
NEXT_PUBLIC_COLLEGE_ID=<nursing-college-uuid>

# Supabase Postgres connection — required by `npm run db:migrate`.
# Get it from: Supabase Dashboard → Project Settings → Database → Connection string → URI
# Use the Session pooler (port 5432), not the Transaction pooler (6543).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ─── MyJKKN Faculty Sync ────────────────────────────────────────────────
# Required for syncing faculty data from MyJKKN Staff API.
JKKN_API_BASE_URL=https://www.jkkn.ai/api
JKKN_API_KEY=<bearer-token-from-myjkkn>
JKKN_NURSING_INSTITUTION_ID=<nursing-institution-uuid-from-myjkkn>

# Vercel Cron auth — used by the scheduled sync job.
CRON_SECRET=<random-secret-for-vercel-cron>
